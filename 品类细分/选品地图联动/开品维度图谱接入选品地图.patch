@@ -0,0 +1,346 @@
+'use strict';
+/* 开品维度图谱接入思维导图。
+   在地图里对应的分类节点（如 本册纸张 › 水彩纸）下面直接挂：
+     ① 市场在售商品类型 → 类型分组 → 在售类型 → 地图形态（C088…，与原节点同一份记录）
+     ② 分类维度 → 维度组 → 维度类 → 维度 → 取值
+     ③ 缺口与开品机会 → A / B / C / 线索 / 已排除 → 机会
+     ④ 白地图 → 各张白地图（点开看整张表）
+   数据：window.DIMENSION_ATLAS（build_dimension_data.py 生成）；详情写在原有 #detail 面板里。 */
+const DIM = (() => {
+  const A = window.DIMENSION_ATLAS || {categories: [], links: {attach: [], records: {}, cross: {}}};
+  const CATS = new Map(A.categories.map(c => [c.id, c]));
+  const SCORE_DEF = [
+    {k:'d', n:'需求信号', w:.25}, {k:'c', n:'竞争空间', w:.20}, {k:'x', n:'差异化可展示', w:.15},
+    {k:'s', n:'供应链可行', w:.15}, {k:'p', n:'利润空间', w:.15}, {k:'e', n:'依据强度', w:.10}];
+  const PRI = {A:'A 优先验证', B:'B 次优先', C:'C 先观察', Q:'线索（证据不足，待验证）', X:'已排除（核实后不成立）'};
+  const PRI_TAG = {A:'A', B:'B', C:'C', Q:'?', X:'×'};
+  const FLAG = {m:'厂家', s:'卖家', t:'评测', u:'未披露', j:'推断'};
+  const COMP = {hi:'竞争高', mid:'竞争中', lo:'竞争低'};
+  const VERDICT_COLOR = {'可做':'var(--ok)', '可做（配套）':'var(--ok)', '谨慎':'var(--part)', '不建议':'var(--unknown)'};
+  const PRI_COLOR = {A:'var(--gap)', B:'var(--part)', C:'#5d6b8a', Q:'var(--panel)', X:'var(--line)'};
+  const score = o => o.score ? Math.round(SCORE_DEF.reduce((a, d) => a + (o.score[d.k] || 0) * d.w, 0) * 100) / 100 : null;
+  const pri = o => o.state === 'clue' ? 'Q' : o.state === 'out' ? 'X' : (score(o) >= 3.5 ? 'A' : score(o) >= 3.0 ? 'B' : 'C');
+  const e = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  const url = v => { try { const u = new URL(v); return ['https:', 'http:'].includes(u.protocol) ? u.href : ''; } catch { return ''; } };
+  const a = (href, label) => url(href) ? `<a href="${e(url(href))}" target="_blank" rel="noopener noreferrer">${e(label)}</a>` : e(label);
+  const list = v => Array.isArray(v) ? v : (v ? [v] : []);
+
+  // 预处理：类型索引、机会优先级、维度索引
+  for (const c of A.categories) {
+    c._types = new Map(); c._typeGroup = new Map();
+    c.types.forEach(g => g.items.forEach(t => { c._types.set(t.t, t); c._typeGroup.set(t.t, g); }));
+    c.opps.forEach(o => { o._total = score(o); o._pri = pri(o); o._from = String(o.from || '').split('、').map(s => s.trim()).filter(Boolean); });
+    c._dims = new Map();
+    c.dims.forEach(g => g.cats.forEach(k => k.c.forEach(d => c._dims.set(d.t, {g, k, d}))));
+  }
+
+  // 形态 → 维度图谱
+  const matchValue = (want, got) => Array.isArray(want) ? want.includes(got) : want === got;
+  const recordField = (r, k) => k === 'product_type' ? (Object.hasOwn(r, 'product_type') ? r.product_type || '' : r.product_family || '') : (r[k] || '');
+  function catOf(r) {
+    for (const rule of A.links.attach) if (Object.entries(rule.match).every(([k, v]) => matchValue(v, recordField(r, k)))) return rule.dimension;
+    return null;
+  }
+  const typesOf = r => list(A.links.records[r.id]);
+  const crossOf = r => A.links.cross?.[r.id] || null;
+
+  // 本次渲染的节点索引（key → 节点），供详情和定位使用
+  let index = new Map();
+  const DEFAULT_CLOSED = new Set(['cat', 'dcat', 'grids', 'dims']);
+
+  function sectionNodes(N, c, recs, recordNodes) {
+    const base = N.key + '§' + c.id;
+    const mk = (suffix, name, dim, children, records = []) => ({key: base + suffix, name, dim: {cat: c.id, ...dim}, records, children});
+    const used = new Set();
+    // ① 在售类型
+    const tgroups = c.types.map((g, gi) => {
+      const items = g.items.map(t => {
+        const linked = recs.filter(r => typesOf(r)[0] === t.t);
+        linked.forEach(r => used.add(r.id));
+        const kids = linked.map(r => recordNodes.get(r.id)).filter(Boolean);
+        return mk(`§t§${t.t}`, t.t, {role:'type', type:t.t}, kids.length ? kids : null, linked);
+      });
+      return mk(`§tg§${gi}`, g.g, {role:'tgroup', group:gi}, items, items.flatMap(n => n.records));
+    });
+    const unmapped = recs.filter(r => !used.has(r.id));
+    if (unmapped.length) tgroups.push(mk('§unmapped', '地图形态 · 未对应在售类型', {role:'unmapped'}, unmapped.map(r => recordNodes.get(r.id)).filter(Boolean), unmapped));
+    const s1 = mk('§types', '① 市场在售商品类型', {role:'section', sec:'types'}, tgroups, recs);
+    // ② 分类维度
+    const dgroups = c.dims.map((g, gi) => mk(`§dg§${gi}`, g.g, {role:'dgroup', group:gi},
+      g.cats.map((k, ki) => mk(`§dc§${gi}§${ki}`, k.t, {role:'dcat', group:gi, cat2:ki},
+        k.c.map(d => mk(`§d§${d.t}`, d.t, {role:'dim', dimName:d.t},
+          (d.c || []).map((v, vi) => mk(`§v§${d.t}§${vi}`, v.t, {role:'val', dimName:d.t, val:vi}, null))))))));
+    const s2 = mk('§dims', '② 分类维度', {role:'section', sec:'dims'}, dgroups);
+    // ③ 机会
+    const pgroups = ['A', 'B', 'C', 'Q', 'X'].map(p => {
+      const os = c.opps.filter(o => o._pri === p).sort((x, y) => (y._total || 0) - (x._total || 0));
+      return os.length ? mk(`§pg§${p}`, PRI[p], {role:'pgroup', pri:p}, os.map(o => mk(`§o§${o.t}`, o.t, {role:'opp', opp:o.t}, null))) : null;
+    }).filter(Boolean);
+    const s3 = mk('§opps', '③ 缺口与开品机会', {role:'section', sec:'opps'}, pgroups);
+    // ④ 白地图
+    const s4 = mk('§grids', '④ 白地图', {role:'grids'}, c.grids.map(v => mk(`§g§${v.id}`, v.name, {role:'grid', grid:v.id}, null)));
+    return [s1, s2, s3, s4];
+  }
+
+  /** 在 treeData() 生成的树上挂接维度图谱。collapsed / seen 用于首次出现时的默认折叠。 */
+  function attachTree(root, collapsed, seen) {
+    index = new Map();
+    const seenSet = new Set(seen);
+    const visit = (n, parentCat) => {
+      if (n.record || !n.records?.length) return;
+      const ids = new Set(n.records.map(catOf));
+      const id = ids.size === 1 ? [...ids][0] : null;
+      if (id && CATS.has(id) && parentCat !== id) {
+        const recordNodes = new Map();
+        const collect = x => { if (x.record) recordNodes.set(x.record.id, x); else (x.children || []).forEach(collect); };
+        (n.children || []).forEach(collect);
+        n.dim = {role:'cat', cat:id};
+        n.children = sectionNodes(n, CATS.get(id), n.records, recordNodes);
+      }
+      (n.children || []).forEach(ch => visit(ch, id || parentCat));
+    };
+    visit(root, null);
+    const walk = (n, parent) => {
+      if (n.dim) {
+        n.dim.parent = parent;
+        index.set(n.key, n);
+        if (!seenSet.has(n.key)) {
+          seenSet.add(n.key); seen.push(n.key);
+          if (DEFAULT_CLOSED.has(n.dim.role === 'section' ? (n.dim.sec === 'dims' ? 'dims' : '') : n.dim.role) || (n.dim.role === 'pgroup' && n.dim.pri === 'X')) collapsed.add(n.key);
