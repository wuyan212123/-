+#!/usr/bin/env python3
+"""把开品维度图谱数据和对应关系打包成前端脚本 web/dimension-data.js。
+
+数据来源：
+  data/dimension_atlas/<id>.json   开品维度图谱各品类（在售类型、分类维度、机会、白地图），从交接包原样导入
+  dimension_links.json             维度图谱挂在哪个地图节点下、地图形态对应哪个在售类型
+  ../品类细分/src/engine/figs.js    结构示意图生成器（可选；不存在时用内置版本）
+
+用法：python3 selection_map/build_dimension_data.py
+生成物不手改；改数据后重新运行。会校验对应关系里的品类、类型名和形态编号。
+"""
+from pathlib import Path
+import json
+import sys
+
+HERE = Path(__file__).resolve().parent
+DATA = HERE / "data" / "dimension_atlas"
+OUT = HERE / "web" / "dimension-data.js"
+FIGS = HERE / "web" / "dimension-figs.src.js"
+ORDER = ["pen", "book", "wc", "gouache", "acrylic", "oil", "easelFloor", "easelTable", "easelPlein",
+         "easelKids", "easelDisplay", "artBox", "artCabinet"]
+
+
+def main() -> None:
+    cats = {p.stem: json.loads(p.read_text(encoding="utf-8")) for p in DATA.glob("*.json")}
+    links = json.loads((HERE / "dimension_links.json").read_text(encoding="utf-8"))
+    records = {r["id"] for r in json.loads((HERE / "data" / "product_map.json").read_text(encoding="utf-8"))["records"]}
+    errors = []
+    types = {cid: {i["t"] for g in c["types"] for i in g["items"]} for cid, c in cats.items()}
+    attach_ids = [a["dimension"] for a in links["attach"]]
+    for cid in attach_ids:
+        if cid not in cats:
+            errors.append(f"attach 引用了不存在的维度图谱：{cid}")
+    for rid, names in links["records"].items():
+        if rid not in records:
+            errors.append(f"records 引用了不存在的形态编号：{rid}")
+        if not any(n in types[c] for c in types for n in names[:1]):
+            errors.append(f"{rid} 的主对应类型不存在：{names[0]}")
+        for n in names:
+            if not any(n in t for t in types.values()):
+                errors.append(f"{rid} 对应的类型不存在：{n}")
+    for rid, x in links.get("cross", {}).items():
+        if x["dimension"] not in cats or x["type"] not in types[x["dimension"]]:
+            errors.append(f"cross {rid} 指向不存在的类型：{x}")
+    if errors:
+        sys.exit("对应关系校验失败：\n" + "\n".join(errors))
+    ordered = [cats[c] for c in ORDER if c in cats] + [c for k, c in cats.items() if k not in ORDER]
+    figs = FIGS.read_text(encoding="utf-8")
+    payload = json.dumps({"categories": ordered, "links": links}, ensure_ascii=False, separators=(",", ":"))
+    OUT.write_text(
+        "/* 生成物：python3 selection_map/build_dimension_data.py。不要手改。 */\n"
+        f"window.DIMENSION_ATLAS={payload};\n"
+        "window.DimFig=(()=>{\n" + figs + "\nreturn fig;\n})();\n",
+        encoding="utf-8")
+    print(f"已生成 {OUT.relative_to(HERE.parent)}：{len(ordered)} 个品类，{len(links['records'])} 条形态对应，{OUT.stat().st_size // 1024} KB")
+
+
+if __name__ == "__main__":
+    main()
